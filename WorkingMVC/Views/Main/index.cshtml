@model List<CategoryItemModelUser>

@{
	Layout = "MainLayout";
	ViewData["Title"] = "Main";
}
<h1>Магазин АТБ</h1>
<div class="container">
	<h2>Категорії</h2>
	<table class="table">
		<thead>
			<tr>
				<th scope="col">#</th>
				<th scope="col">Фото</th>
				<th scope="col">Назва</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var category in Model)
			{
				<tr>
					<th scope="row">@category.Id</th>
					<td>
						<img src="@category.Image" width="100" />
					</td>
					<td>@category.Name</td>
				</tr>
			}
		</tbody>
	</table>
</div>
