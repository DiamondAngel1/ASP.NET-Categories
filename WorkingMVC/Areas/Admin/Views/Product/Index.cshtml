@model List<ProductItemModel>
@{
    ViewData["Title"] = "Товари";
}

<h1>Товари</h1>
<a asp-action="Create" class="btn btn-success mb-4">Додати товар</a>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var product in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-light">
                    <strong>@product.Name</strong>
                </div>
                <div class="card-body">
                    @if (product.Images.Count == 1)
                    {
                        <img src="@product.Images[0]" class="img-fluid mb-2" style="max-width: 100%; object-fit: cover;" />
                    }
                    else if (product.Images.Count > 1)
                    {
                        var carouselId = $"carousel-{product.Id}";
                        <div id="@carouselId" class="carousel slide mb-2" data-bs-ride="carousel">
                            <div class="carousel-inner">
                                @for (int i = 0; i < product.Images.Count; i++)
                                {
                                    <div class="carousel-item @(i == 0 ? "active" : "")">
                                        <img src="@product.Images[i]" class="d-block w-100" style=" object-fit: cover;" />
                                    </div>
                                }
                            </div>
                            <button class="carousel-control-prev" type="button" data-bs-target="#@carouselId" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Попереднє</span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#@carouselId" data-bs-slide="next">
                                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                <span class="visually-hidden">Наступне</span>
                            </button>
                        </div>
                    }

                    <p><strong>Ціна:</strong> @product.Price ₴</p>
                    <p><strong>Категорія:</strong> @product.CategoryName</p>
                    <p>@product.Description</p>
                    <div class="d-flex gap-2 mt-2">
                        <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-warning btn-sm">Редагувати</a>
                        <form asp-action="Delete" asp-route-id="@product.Id" method="post" onsubmit="return confirm('Видалити товар?')">
                            <button type="submit" class="btn btn-danger btn-sm">Видалити</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>